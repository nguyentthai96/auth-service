{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Endpoint Latency Distribution",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"auth-service\", uri=~\"$endpoint\"}[1m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"auth-service\", uri=~\"$endpoint\"}[1m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"auth-service\", uri=~\"$endpoint\"}[1m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Endpoint Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"auth-service\", uri=~\"$endpoint\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"auth-service\", uri=~\"$endpoint\"}[1m])) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "Endpoint Throughput",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"auth-service\", uri=~\"$endpoint\"}[1m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "DB Pool During Endpoint Load",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"auth-service\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"auth-service\"}",
          "legendFormat": "Pending",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["performance", "auth-service", "api-detail"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "definition": "label_values(http_server_requests_seconds_count{application=\"auth-service\"}, uri)",
        "name": "endpoint",
        "query": "label_values(http_server_requests_seconds_count{application=\"auth-service\"}, uri)",
        "refresh": 2,
        "type": "query",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Auth Service — API Detail",
  "uid": "auth-api-detail"
}
