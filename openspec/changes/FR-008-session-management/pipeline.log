: 'Base directory for the search. Relative to workspace or absolute. Default: workspace root.'}}, 'required': ['pattern']}}, {'name': 'write_file', 'description': 'Create or overwrite a file with the given content. Parent directories are created automatically. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'File path to write. Relative to workspace or absolute (must be within workspace).'}, 'content': {'type': 'string', 'description': 'File content to write.'}}, 'required': ['path', 'content']}}, {'name': 'edit_file', 'description': 'Edit an existing file by replacing target content with new content. The target_content must exactly match text in the file. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'File path to edit.'}, 'target_content': {'type': 'string', 'description': 'Exact text to find and replace. Must match file content exactly.'}, 'replacement_content': {'type': 'string', 'description': 'New text to replace the target with.'}}, 'required': ['path', 'target_content', 'replacement_content']}}, {'name': 'delete_file', 'description': 'Delete a file or directory within the workspace. Protected paths (.git, node_modules, __pycache__, .env) cannot be deleted. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'Path to delete. Relative to workspace or absolute (must be within workspace).'}}, 'required': ['path']}}, {'name': 'run_command', 'description': 'Execute a shell command in the workspace directory. Only allowed commands can be run (sandboxed). Output is capped at 10,000 characters. Timeout: 60 seconds.', 'input_schema': {'type': 'object', 'properties': {'command': {'type': 'string', 'description': 'Shell command to execute.'}, 'cwd': {'type': 'string', 'description': 'Working directory for the command. Relative to workspace or absolute. Optional.'}}, 'required': ['command']}}, {'name': 'web_search', 'description': 'Search the web for information using DuckDuckGo. Returns JSON array of results with title, href, and body snippet. No API key required.', 'input_schema': {'type': 'object', 'properties': {'query': {'type': 'string', 'description': 'Search query string.'}, 'max_results': {'type': 'integer', 'description': 'Maximum number of results to return. Default: 5.'}}, 'required': ['query']}}, {'name': 'read_url', 'description': 'Read and extract main content from a URL. Returns clean text content (extracted from HTML). Supports http and https URLs. Output truncated to 10,000 chars.', 'input_schema': {'type': 'object', 'properties': {'url': {'type': 'string', 'description': 'URL to read (must start with http:// or https://).'}, 'timeout': {'type': 'integer', 'description': 'Request timeout in seconds. Default: 30.'}}, 'required': ['url']}}, {'name': 'auto_decide', 'description': 'When facing ambiguous decisions with multiple options, run a multi-agent debate (Proposer → Critic → Judge) to reach a well-reasoned autonomous decision. Returns the final decision with reasoning and a path to the debate log.', 'input_schema': {'type': 'object', 'properties': {'question': {'type': 'string', 'description': 'The decision question to resolve.'}, 'context': {'type': 'string', 'description': 'Background context for the decision. Optional.'}, 'options': {'type': 'array', 'items': {'type': 'string'}, 'description': 'List of available options to choose from. Optional.'}}, 'required': ['question']}}], 'stream': True}}
