ies': {'url': {'type': 'string', 'description': 'URL to read (must start with http:// or https://).'}, 'timeout': {'type': 'integer', 'description': 'Request timeout in seconds. Default: 30.'}}, 'required': ['url']}}, {'name': 'auto_decide', 'description': 'When facing ambiguous decisions with multiple options, run a multi-agent debate (Proposer → Critic → Judge) to reach a well-reasoned autonomous decision. Returns the final decision with reasoning and a path to the debate log.', 'input_schema': {'type': 'object', 'properties': {'question': {'type': 'string', 'description': 'The decision question to resolve.'}, 'context': {'type': 'string', 'description': 'Background context for the decision. Optional.'}, 'options': {'type': 'array', 'items': {'type': 'string'}, 'description': 'List of available options to choose from. Optional.'}}, 'required': ['question']}}], 'stream': True}}
