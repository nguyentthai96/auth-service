tive to workspace or absolute.'}, 'is_regex': {'type': 'boolean', 'description': 'If true, treat query as regex. Default: false.'}, 'case_insensitive': {'type': 'boolean', 'description': 'If true, case-insensitive search. Default: false.'}, 'file_pattern': {'type': 'string', 'description': "Glob pattern to filter files, e.g. '*.py', '*.ts'. Optional."}}, 'required': ['query']}}, {'name': 'glob_search', 'description': "Find files matching a glob pattern within the workspace. Returns file paths relative to workspace root. Supports patterns like '**/*.py', '*.md', 'src/**/*.ts'. Max 100 results.", 'input_schema': {'type': 'object', 'properties': {'pattern': {'type': 'string', 'description': "Glob pattern (e.g., '**/*.py', '*.md')."}, 'path': {'type': 'string', 'description': 'Base directory for the search. Relative to workspace or absolute. Default: workspace root.'}}, 'required': ['pattern']}}, {'name': 'write_file', 'description': 'Create or overwrite a file with the given content. Parent directories are created automatically. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'File path to write. Relative to workspace or absolute (must be within workspace).'}, 'content': {'type': 'string', 'description': 'File content to write.'}}, 'required': ['path', 'content']}}, {'name': 'edit_file', 'description': 'Edit an existing file by replacing target content with new content. The target_content must exactly match text in the file. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'File path to edit.'}, 'target_content': {'type': 'string', 'description': 'Exact text to find and replace. Must match file content exactly.'}, 'replacement_content': {'type': 'string', 'description': 'New text to replace the target with.'}}, 'required': ['path', 'target_content', 'replacement_content']}}, {'name': 'delete