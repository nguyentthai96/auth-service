um.', 'title': 'Health Type', 'type': 'string'}}, 'title': 'analyze_db_healthArguments', 'type': 'object'}}, {'name': 'mcp_postgres_analyze_query_indexes', 'description': '[MCP:postgres] Analyze a list of (up to 10) SQL queries and recommend optimal indexes', 'input_schema': {'properties': {'max_index_size_mb': {'default': 10000, 'description': 'Max index size in MB', 'title': 'Max Index Size Mb', 'type': 'integer'}, 'method': {'default': 'dta', 'description': 'Method to use for analysis', 'enum': ['dta', 'llm'], 'title': 'Method', 'type': 'string'}, 'queries': {'description': 'List of Query strings to analyze', 'items': {'type': 'string'}, 'title': 'Queries', 'type': 'array'}}, 'required': ['queries'], 'title': 'analyze_query_indexesArguments', 'type': 'object'}}, {'name': 'mcp_postgres_analyze_workload_indexes', 'description': '[MCP:postgres] Analyze frequently executed queries in the database and recommend optimal indexes', 'input_schema': {'properties': {'max_index_size_mb': {'default': 10000, 'description': 'Max index size in MB', 'title': 'Max Index Size Mb', 'type': 'integer'}, 'method': {'default': 'dta', 'description': 'Method to use for analysis', 'enum': ['dta', 'llm'], 'title': 'Method', 'type': 'string'}}, 'title': 'analyze_workload_indexesArguments', 'type': 'object'}}, {'name': 'mcp_postgres_execute_sql', 'description': '[MCP:postgres] Execute any SQL query', 'input_schema': {'properties': {'sql': {'default': 'all', 'description': 'SQL to run', 'title': 'Sql', 'type': 'string'}}, 'title': 'execute_sqlArguments', 'type': 'object'}}, {'name': 'mcp_postgres_explain_query', 'description': '[MCP:postgres] Explains the execution plan for a SQL query, showing how the database will execute it and provides detailed cost estimates.', 'input_schema': {'properties': {'analyze': {'default': False, 'description': 'When True, actually runs the query to show real execution statistics instead of estimates. Takes longer but provides more accurate information.', 'title'