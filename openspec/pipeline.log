in/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:7: * Auth service error codes — implements base-core ErrorCodeBase.\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:10:enum class AuthErrorCode(\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:58:     * Bridge to base-core ErrorCodeBase via delegation.\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:60:    private val delegate = object : ErrorCodeBase(errorCode, msgCode, description) {}\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:62:    fun getErrorCode(): String = errorCode\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/AuthErrorCode.kt:63:    fun toErrorCodeBase(): ErrorCodeBase = delegate\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/CipherExceptions.kt:7: * Each maps to an AuthErrorCode (AUTH_030~039) for RFC 7807 ProblemDetail response.\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/CipherExceptions.kt:15:    authError = AuthErrorCode.E2EE_TIME_SKEW,\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/CipherExceptions.kt:24:    authError = AuthErrorCode.E2EE_REPLAY_DETECTED,\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/auth-service/src/main/kotlin/com/ntt/authservice/shared/exception/CipherExceptions.kt:34:    authError = AuthErrorCode.E2EE_CONTEXT_MISMATCH,\n/home/nguyentthai96/Desktop/bigbang/boilerplate/services/aut