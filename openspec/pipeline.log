input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'Path to delete. Relative to workspace or absolute (must be within workspace).'}}, 'required': ['path']}}, {'name': 'run_command', 'description': 'Execute a shell command in the workspace directory. Only allowed commands can be run (sandboxed). Output is capped at 10,000 characters. Timeout: 60 seconds.', 'input_schema': {'type': 'object', 'properties': {'command': {'type': 'string', 'description': 'Shell command to execute.'}, 'cwd': {'type': 'string', 'description': 'Working directory for the command. Relative to workspace or absolute. Optional.'}}, 'required': ['command']}}, {'name': 'ddg_search', 'description': 'Search the web using DuckDuckGo for additional results. Use this as a SUPPLEMENT to the built-in web_search tool when you need more search results or different perspectives. Returns JSON array of results with title, href, and body snippet. No API key required.', 'input_schema': {'type': 'object', 'properties': {'query': {'type': 'string', 'description': 'Search query string.'}, 'max_results': {'type': 'integer', 'description': 'Maximum number of results to return. Default: 5.'}}, 'required': ['query']}}, {'name': 'read_url', 'description': 'Read and extract main content from a URL. Returns clean text content (extracted from HTML). Supports http and https URLs. Output truncated to 10,000 chars.', 'input_schema': {'type': 'object', 'properties': {'url': {'type': 'string', 'description': 'URL to read (must start with http:// or https://).'}, 'timeout': {'type': 'integer', 'description': 'Request timeout in seconds. Default: 30.'}}, 'required': ['url']}}, {'name': 'auto_decide', 'description': 'When facing ambiguous decisions with multiple options, run a multi-agent debate (Proposer → Critic → Judge) to reach a well-reasoned autonomous decision. Returns the final decision with reasoning and a path to the debate log.', 'input_schema': {'type': 'object', 'properties': {'question': {'type': 'string', 'description': 'The decision question to resolve.'}, 'context': {'type': 'string', 'description': 'Background context for the decision. Optional.'}, 'options': {'type': 'array', 'items': {'type': 'string'}, 'description': 'List of available options to choose from. Optional.'}}, 'required': ['question']}}, {'type': 'web_search_20250305', 'name': 'web_search', 'max_uses': 5}, {'name': 'mcp_socraticode_codebase_about', 'description': '[MCP:socraticode] Display information about SocratiCode — what it is, its tools and how to use it. Use this to get a quick overview of the MCP tools and their purpose.', 'input_schema': {'properties': {}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context', 'description': "[MCP:socraticode] List all context artifacts defined in .socraticodecontextartifacts.json — database schemas, API specs, infra configs, architecture docs, etc. Shows each artifact's name, description, path, and index status. Use this to discover what project knowledge is available beyond source code.", 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory. If omitted, uses the current working directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_index', 'description': '[MCP:socraticode] Index or re-index all context artifacts defined in .socraticodecontextartifacts.json. Chunks and embeds artifact content into the vector database for semantic search. Usually not needed — codebase_context_search auto-indexes on first use.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_remove', 'description': '[MCP:socraticode] Remove all indexed context artifacts for a project from the vector database. Blocked while indexing is in progress — use codebase_stop or wait for the operation to finish first.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'required': ['projectPath'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_search', 'description': '[MCP:socraticode] Semantic search across context artifacts (database schemas, API specs, infra configs, etc.) defined in .socraticodecontextartifacts.json. Auto-indexes on first use and auto-detects stale artifacts. Use this to find relevant infrastructure or domain knowledge.', 'input_schema': {'additionalProperties': False, 'properties': {'artifactName': {'description': "Filter search to a specific artifact by name (e.g. 'database-schema'). Omit to search across all artifacts.", 'type': 'string'}, 'limit': {'description': 'Maximum number of results to return. Default: 10.', 'maximum': 50, 'minimum': 1, 'type': 'number'}, 'minScore': {'description': 'Minimum RRF score threshold (0-1). Results below this are filtered out. Default: 0.10 (override globally via SEARCH_MIN_SCORE env var). Set to 0 to disable filtering.', 'maximum': 1, 'minimum': 0, 'type': 'number'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}, 'query': {'description': "Natural language search query (e.g. 'tables related to billing', 'authentication endpoints', 'deployment resource limits').", 'type': 'string'}}, 'required': ['query'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_flow', 'description': '[MCP:socraticode] Trace the EXECUTION FLOW forward from an entry point — what does this code call into? With NO args, returns a ranked list of auto-detected entry points (orphans with outgoing calls, conventional names like main(), framework routes, tests). With an entrypoint argument, returns the call tree.', 'input_schema': {'additionalProperties': False, 'properties': {'depth': {'description': 'Maximum DFS depth (default 5, max