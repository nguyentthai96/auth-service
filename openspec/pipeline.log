iption': 'File path to edit.'}, 'target_content': {'type': 'string', 'description': 'Exact text to find and replace. Must match file content exactly.'}, 'replacement_content': {'type': 'string', 'description': 'New text to replace the target with.'}}, 'required': ['path', 'target_content', 'replacement_content']}}, {'name': 'delete_file', 'description': 'Delete a file or directory within the workspace. Protected paths (.git, node_modules, __pycache__, .env) cannot be deleted. Path must be within the workspace directory.', 'input_schema': {'type': 'object', 'properties': {'path': {'type': 'string', 'description': 'Path to delete. Relative to workspace or absolute (must be within workspace).'}}, 'required': ['path']}}, {'name': 'run_command', 'description': 'Execute a shell command in the workspace directory. Only allowed commands can be run (sandboxed). Output is capped at 10,000 characters. Timeout: 60 seconds.', 'input_schema': {'type': 'object', 'properties': {'command': {'type': 'string', 'description': 'Shell command to execute.'}, 'cwd': {'type': 'string', 'description': 'Working directory for the command. Relative to workspace or absolute. Optional.'}}, 'required': ['command']}}, {'name': 'ddg_search', 'description': 'Search the web using DuckDuckGo for additional results. Use this as a SUPPLEMENT to the built-in web_search tool when you need more search results or different perspectives. Returns JSON array of results with title, href, and body snippet. No API key required.', 'input_schema': {'type': 'object', 'properties': {'query': {'type': 'string', 'description': 'Search query string.'}, 'max_results': {'type': 'integer', 'description': 'Maximum number of results to return. Default: 5.'}}, 'required': ['query']}}, {'name': 'read_url', 'description': 'Read and extract main content from a URL. Returns clean text content (extracted from HTML). Supports http and https URLs. Output truncated to 10,000 chars.', 'input_schema': {'type': 'object', 'properties': {'url': {'type': 'string', 'description': 'URL to read (must start with http:// or https://).'}, 'timeout': {'type': 'integer', 'description': 'Request timeout in seconds. Default: 30.'}}, 'required': ['url']}}, {'name': 'auto_decide', 'description': 'When facing ambiguous decisions with multiple options, run a multi-agent debate (Proposer → Critic → Judge) to reach a well-reasoned autonomous decision. Returns the final decision with reasoning and a path to the debate log.', 'input_schema': {'type': 'object', 'properties': {'question': {'type': 'string', 'description': 'The decision question to resolve.'}, 'context': {'type': 'string', 'description': 'Background context for the decision. Optional.'}, 'options': {'type': 'array', 'items': {'type': 'string'}, 'description': 'List of available options to choose from. Optional.'}}, 'required': ['question']}}, {'type': 'web_search_20250305', 'name': 'web_search', 'max_uses': 5}, {'name': 'mcp_socraticode_codebase_about', 'description': '[MCP:socraticode] Display information about SocratiCode — what it is, its tools and how to use it. Use this to get a quick overview of the MCP tools and their purpose.', 'input_schema': {'properties': {}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context', 'description': "[MCP:socraticode] List all context artifacts defined in .socraticodecontextartifacts.json — database schemas, API specs, infra configs, architecture docs, etc. Shows each artifact's name, description, path, and index status. Use this to discover what project knowledge is available beyond source code.", 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory. If omitted, uses the current working directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_index', 'description': '[MCP:socraticode] Index or re-index all context artifacts defined in .socraticodecontextartifacts.json. Chunks and embeds artifact content into the vector database for semantic search. Usually not needed — codebase_context_search auto-indexes on first use.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_remove', 'description': '[MCP:socraticode] Remove all indexed context artifacts for a project from the vector database. Blocked while indexing is in progress — use codebase_stop or wait for the operation to finish first.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'required': ['projectPath'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_context_search', 'description': '[MCP:socraticode] Semantic search across context artifacts (database schemas, API specs, infra configs, etc.) defined in .socraticodecontextartifacts.json. Auto-indexes on first use and auto-detects stale artifacts. Use this to find relevant infrastructure or domain knowledge.', 'input_schema': {'additionalProperties': False, 'properties': {'artifactName': {'description': "Filter search to a specific artifact by name (e.g. 'database-schema'). Omit to search across all artifacts.", 'type': 'string'}, 'limit': {'description': 'Maximum number of results to return. Default: 10.', 'maximum': 50, 'minimum': 1, 'type': 'number'}, 'minScore': {'description': 'Minimum RRF score threshold (0-1). Results below this are filtered out. Default: 0.10 (override globally via SEARCH_MIN_SCORE env var). Set to 0 to disable filtering.', 'maximum': 1, 'minimum': 0, 'type': 'number'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}, 'query': {'description': "Natural language search query (e.g. 'tables related to billing', 'authentication endpoints', 'deployment resource limits').", 'type': 'string'}}, 'required': ['query'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_flow', 'description': '[MCP:socraticode] Trace the EXECUTION FLOW forward from an entry point — what does this code call into? With NO args, returns a ranked list of auto-detected entry points (orphans with outgoing calls, conventional names like main(), framework routes, tests). With an entrypoint argument, returns the call tree.', 'input_schema': {'additionalProperties': False, 'properties': {'depth': {'description': 'Maximum DFS depth (default 5, max 10).', 'type': 'number'}, 'entrypoint': {'description': 'Symbol name to trace from. Omit to list auto-detected entry points.', 'type': 'string'}, 'file': {'description': 'Optional file hint to disambiguate the symbol.', 'type': 'string'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_build', 'description': '[MCP:socraticode] Build a dependency graph of the codebase using static analysis (ast-grep). Maps import/require/export relationships between files. Runs in the background — call codebase_graph_status to poll progress until complete.', 'input_schema': {'additionalProperties': False, 'properties': {'extraExtensions': {'description': "Comma-separated list of additional file extensions to include in the graph (e.g. '.tpl,.blade'). Files with non-standard extensions are included as leaf nodes (dependency targets). Can also be set globally via EXTRA_EXTENSIONS env var.", 'type': 'string'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_circular', 'description': '[MCP:socraticode] Find circular dependencies in the codebase.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_query', 'description': '[MCP:socraticode] Query the code dependency graph for a specific file. Returns what the file imports and what files depend on it.', 'input_schema': {'additionalProperties': False, 'properties': {'filePath': {'description': "Relative path of the file to query (e.g. 'src/index.ts').", 'type': 'string'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'required': ['filePath'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_remove', 'description': "[MCP:socraticode] Remove a project's persisted code graph. Waits for any in-flight graph build to finish first. The graph can be rebuilt with codebase_graph_build or will be rebuilt automatically on the next codebase_index.", 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'required': ['projectPath'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_stats', 'description': '[MCP:socraticode] Get statistics about the code dependency graph: total files, edges, most connected files, orphan files, circular dependencies.', 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_status', 'description': "[MCP:socraticode] Check the status of the code dependency graph: build progress (if building), node/edge count, when it was last built, whether it's cached in memory. Use this to poll progress after calling codebase_graph_build.", 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_graph_visualize', 'description': '[MCP:socraticode] Visualise the code dependency graph. Two modes:\n  • mode="mermaid" (default) — returns a Mermaid diagram (text) colour-coded by language, circular deps highlighted. Best for inline rendering inside chat, GitHub, or editors that render Mermaid.\n  • mode="interactive" — writes a self-contained HTML page (vendored Cytoscape.js + Dagre, works offline) and opens it in the user\'s default browser. Shows the file graph and, when a symbol graph is available and fits, a Symbols toggle with the symbol-level call graph. Interactions: click node for sidebar with imports/dependents/symbols list; right-click node to highlight its blast radius (reverse-transitive closure); live search; layout switcher (Dagre / force / concentric / breadth-first / grid / circle); PNG export. Use this when the user asks for a visual/interactive view, wants to explore visually, or needs a shareable diagram.', 'input_schema': {'additionalProperties': False, 'properties': {'mode': {'description': '"mermaid" (default — text diagram) or "interactive" (browser-based explorer).', 'enum': ['mermaid', 'interactive'], 'type': 'string'}, 'open': {'description': 'In interactive mode, whether to auto-open the browser. Default true. Set false to just get the file path (useful in headless environments).', 'type': 'boolean'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_health', 'description': '[MCP:socraticode] Check the health of all infrastructure: Docker, Qdrant container, Ollama, and embedding model. Use this to diagnose setup issues.', 'input_schema': {'properties': {}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_impact', 'description': "[MCP:socraticode] Impact Analysis — return the BLAST RADIUS for a file or symbol. Lists every file (and, where helpful, function) that could break if you change the target. Polymorphic on target: a path-like string ('src/foo.ts') triggers file-mode; a name-like string ('validateUser') triggers symbol-mode. Use this BEFORE refactoring, renaming, or deleting code to know what depends on it.", 'input_schema': {'additionalProperties': False, 'properties': {'depth': {'description': 'How many hops back to walk (default 3, max 10).', 'type': 'number'}, 'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}, 'target': {'description': 'Target file path (relative) OR symbol name.', 'type': 'string'}}, 'required': ['target'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_index', 'description': '[MCP:socraticode] Start indexing a codebase in the background. Returns immediately. Call codebase_status to poll progress until 100%. Do NOT search until indexing is complete. If already indexing, returns current progress.', 'input_schema': {'additionalProperties': False, 'properties': {'extraExtensions': {'description': "Comma-separated list of additional file extensions to index beyond the built-in set (e.g. '.tpl,.blade,.hbs'). Useful for projects with non-standard file extensions. Can also be set globally via EXTRA_EXTENSIONS env var.", 'type': 'string'}, 'projectPath': {'description': 'Absolute path to the project directory. If omitted, uses the current working directory.', 'type': 'string'}}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_list_projects', 'description': '[MCP:socraticode] List all projects that have been indexed (have collections in Qdrant).', 'input_schema': {'properties': {}, 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_remove', 'description': "[MCP:socraticode] Remove a project's codebase index entirely from the vector database. Safely stops the file watcher, cancels any in-progress indexing/update (with drain), and waits for any in-flight graph build before deleting.", 'input_schema': {'additionalProperties': False, 'properties': {'projectPath': {'description': 'Absolute path to the project directory.', 'type': 'string'}}, 'required': ['projectPath'], 'type': 'object'}}, {'name': 'mcp_socraticode_codebase_search', 'description': '[MC